{
  "id": "lowerThirdMinimal",
  "name": "姓名条·极简",
  "category": "player",
  "family": "lowerThird",
  "style": "minimal",
  "builtin": true,
  "slots": [
    {
      "key": "name",
      "label": "姓名",
      "type": "text",
      "required": true,
      "maxLength": 24,
      "placeholder": "选手A"
    },
    {
      "key": "subtitle",
      "label": "副标题",
      "type": "text",
      "required": false,
      "maxLength": 48,
      "placeholder": "中二节奏 / 1P"
    },
    {
      "key": "avatar",
      "label": "头像",
      "type": "image",
      "required": false,
      "aspectRatio": "1:1",
      "entitySource": "player"
    },
    {
      "key": "teamName",
      "label": "队伍名",
      "type": "text",
      "required": false,
      "maxLength": 32
    },
    {
      "key": "teamAvatar",
      "label": "队伍 Logo",
      "type": "image",
      "required": false,
      "aspectRatio": "1:1"
    },
    {
      "key": "accentColor",
      "label": "强调线颜色",
      "type": "color",
      "required": false,
      "default": "#d9d9d9"
    }
  ],
  "defaultAnim": {
    "in": "fadeUp",
    "out": "fadeOut",
    "durationMs": 500
  },
  "cssVars": {
    "--lm-accent": "#d9d9d9",
    "--lm-name-size": "40px",
    "--lm-sub-size": "19px",
    "--lm-rule-w": "96px",
    "--lm-avatar-size": "64px",
    "--lm-font": "'Noto Sans SC','Microsoft YaHei',system-ui,sans-serif",
    "--lm-team-size": "17px",
    "--lm-team-logo": "22px"
  },
  "html": "<div class=\"lm-root\" data-slot=\"accentColor\" data-slot-type=\"stylevar:--lm-accent\">\n  <div class=\"lm-avatar\">\n    <img data-slot=\"avatar\" data-slot-type=\"image\" alt=\"\" />\n    <span class=\"lm-fallback\"></span>\n  </div>\n  <div class=\"lm-meta\">\n    <div class=\"lm-team\"><span class=\"lm-team-logo\"><img data-slot=\"teamAvatar\" data-slot-type=\"image\" alt=\"\" /><span class=\"lm-team-fallback\"></span></span><span class=\"lm-team-name\" data-slot=\"teamName\"></span></div>\n    <div class=\"lm-name\" data-slot=\"name\"></div>\n    <div class=\"lm-rule\"></div>\n    <div class=\"lm-sub\" data-slot=\"subtitle\"></div>\n  </div>\n</div>",
  "css": ".lm-root{position:absolute;left:64px;bottom:72px;display:flex;align-items:center;gap:16px;font-family:var(--lm-font);text-shadow:0 2px 10px rgba(0,0,0,.8);}\n.lm-avatar{width:var(--lm-avatar-size);height:var(--lm-avatar-size);overflow:hidden;background:rgba(10,10,11,.72);border:1px solid rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.lm-avatar img{width:100%;height:100%;object-fit:cover;display:none;}\n.lm-avatar img.is-ready{display:block;}\n.lm-fallback{width:7px;height:7px;background:var(--lm-accent);}\n.lm-avatar:has(img.is-ready) .lm-fallback{display:none;}\n.lm-meta{display:flex;flex-direction:column;gap:2px;}\n.lm-team{display:flex;align-items:center;gap:7px;}\n.lm-team:not(:has(.lm-team-name:not(:empty),img.is-ready)){display:none;}\n.lm-team-logo{position:relative;width:var(--lm-team-logo);height:var(--lm-team-logo);flex:0 0 auto;display:flex;align-items:center;justify-content:center;}\n.lm-team-logo img{width:100%;height:100%;object-fit:contain;display:none;}\n.lm-team-logo img.is-ready{display:block;}\n.lm-team-fallback{width:5px;height:5px;background:var(--lm-accent);}\n.lm-team-logo:has(img.is-ready) .lm-team-fallback{display:none;}\n.lm-team-name{color:var(--lm-accent);font-size:var(--lm-team-size);font-weight:700;letter-spacing:1.6px;line-height:1.2;white-space:nowrap;}\n.lm-team-name:empty{display:none;}\n.lm-name{color:#fff;font-size:var(--lm-name-size);font-weight:700;line-height:1.15;white-space:nowrap;letter-spacing:.4px;}\n.lm-rule{width:var(--lm-rule-w);height:2px;background:var(--lm-accent);margin:4px 0 3px;}\n.lm-rule:last-child{display:none;}\n.lm-sub{color:#d0d0c9;font-size:var(--lm-sub-size);font-weight:400;line-height:1.3;white-space:nowrap;}\n.lm-sub:empty{display:none;}"
}
