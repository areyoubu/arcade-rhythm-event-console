{
  "id": "thanksGrid",
  "name": "网格致谢",
  "category": "credits",
  "family": "thanksGrid",
  "style": "broadcast",
  "builtin": true,
  "slots": [
    {
      "key": "heading",
      "label": "标题",
      "type": "text",
      "required": false,
      "maxLength": 36,
      "default": "感谢以下合作伙伴"
    },
    {
      "key": "items",
      "label": "赞助商条目",
      "type": "image",
      "required": false,
      "multi": true,
      "rowKeys": [
        "image",
        "name",
        "tier"
      ],
      "help": "每项 {image:'/media/xxx.png', name:'XX', tier:'金牌'}；纯字符串视为 Logo 地址。",
      "entitySource": "sponsor"
    },
    {
      "key": "columns",
      "label": "列数",
      "type": "number",
      "required": false,
      "default": 4
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "required": false,
      "default": "#d9d9d9"
    }
  ],
  "defaultAnim": {
    "in": "fadeIn",
    "out": "fadeOut",
    "durationMs": 500
  },
  "cssVars": {
    "--tg-accent": "#d9d9d9",
    "--tg-heading-size": "34px",
    "--tg-name-size": "17px",
    "--tg-cell-h": "128px",
    "--tg-cols": "4",
    "--tg-font": "'Noto Sans SC','Microsoft YaHei',system-ui,sans-serif"
  },
  "html": "<div class=\"tg-root\" data-slot=\"accentColor\" data-slot-type=\"stylevar:--tg-accent\">\n  <div class=\"tg-heading\" data-slot=\"heading\"></div>\n  <div class=\"tg-grid\" data-slot=\"items\" data-slot-multi data-set-var=\"--tg-cols:columns\">\n    <div class=\"tg-cell\">\n      <div class=\"tg-logo\"><img src=\"{{image}}\" alt=\"{{name}}\" /><span class=\"tg-fallback\">{{name}}</span></div>\n      <div class=\"tg-name\">{{name}}</div>\n      <div class=\"tg-tier\">{{tier}}</div>\n    </div>\n  </div>\n</div>",
  "css": ".tg-root{position:absolute;inset:0;font-family:var(--tg-font);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px;padding:72px 110px;box-sizing:border-box;background:rgba(8,8,9,.94);}\n.tg-heading{font-size:var(--tg-heading-size);font-weight:700;color:#f2f2ee;letter-spacing:5px;text-align:center;}\n.tg-heading:empty{display:none;}\n.tg-grid{display:grid;grid-template-columns:repeat(var(--tg-cols),minmax(0,1fr));gap:22px 28px;width:100%;max-width:1560px;max-height:76vh;overflow:hidden;}\n.tg-cell{display:flex;flex-direction:column;align-items:center;gap:9px;}\n.tg-logo{height:var(--tg-cell-h);width:100%;display:flex;align-items:center;justify-content:center;background:#121214;border:1px solid #2a2a2e;overflow:hidden;}\n.tg-logo img{max-height:76%;max-width:84%;object-fit:contain;display:none;}\n.tg-logo img.is-ready{display:block;}\n.tg-fallback{font-size:20px;font-weight:700;color:#8c8c85;text-align:center;padding:0 10px;}\n.tg-logo:has(img.is-ready) .tg-fallback{display:none;}\n.tg-name{font-size:var(--tg-name-size);font-weight:600;color:#e7e7e3;text-align:center;line-height:1.3;}\n.tg-tier{font-size:11px;font-weight:600;letter-spacing:1.5px;color:var(--tg-accent);text-transform:uppercase;}\n.tg-tier:empty{display:none;}"
}
