{
  "id": "lowerThirdWhite",
  "name": "姓名条·白底",
  "category": "player",
  "family": "lowerThird",
  "style": "contrast",
  "builtin": true,
  "slots": [
    {
      "key": "name",
      "label": "姓名",
      "type": "text",
      "required": true,
      "maxLength": 24,
      "placeholder": "选手A"
    },
    {
      "key": "subtitle",
      "label": "副标题",
      "type": "text",
      "required": false,
      "maxLength": 48,
      "placeholder": "中二节奏 / 1P"
    },
    {
      "key": "avatar",
      "label": "头像",
      "type": "image",
      "required": false,
      "aspectRatio": "1:1",
      "entitySource": "player"
    },
    {
      "key": "teamName",
      "label": "队伍名",
      "type": "text",
      "required": false,
      "maxLength": 32
    },
    {
      "key": "teamAvatar",
      "label": "队伍 Logo",
      "type": "image",
      "required": false,
      "aspectRatio": "1:1"
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "color",
      "required": false,
      "default": "#333333"
    }
  ],
  "defaultAnim": {
    "in": "slideLeft",
    "out": "fadeOut",
    "durationMs": 400
  },
  "cssVars": {
    "--ln-accent": "#333333",
    "--ln-name-size": "44px",
    "--ln-sub-size": "20px",
    "--ln-font": "'Noto Sans SC','Microsoft YaHei',system-ui,sans-serif",
    "--ln-avatar-size": "104px",
    "--ln-team-size": "20px",
    "--ln-team-logo": "26px"
  },
  "html": "<div class=\"ln-root\" data-slot=\"accentColor\" data-slot-type=\"stylevar:--ln-accent\">\n  <div class=\"ln-avatar\">\n    <img data-slot=\"avatar\" data-slot-type=\"image\" alt=\"\" />\n    <span class=\"ln-fallback\">?</span>\n  </div>\n  <div class=\"ln-panel\">\n    <span class=\"ln-edge\"></span>\n    <div class=\"ln-text\">\n      <div class=\"ln-team\"><span class=\"ln-team-logo\"><img data-slot=\"teamAvatar\" data-slot-type=\"image\" alt=\"\" /><span class=\"ln-team-fallback\"></span></span><span class=\"ln-team-name\" data-slot=\"teamName\"></span></div>\n      <div class=\"ln-name\" data-slot=\"name\"></div>\n      <div class=\"ln-sub\" data-slot=\"subtitle\"></div>\n    </div>\n  </div>\n</div>",
  "css": ".ln-root{position:absolute;left:64px;bottom:72px;display:flex;align-items:flex-end;font-family:var(--ln-font);}\n.ln-avatar{width:var(--ln-avatar-size);height:var(--ln-avatar-size);overflow:hidden;background:#e7e6e0;border:1px solid #111;border-right:none;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}\n.ln-avatar img{width:100%;height:100%;object-fit:cover;display:none;}\n.ln-avatar img.is-ready{display:block;}\n.ln-fallback{color:#8a8a83;font-size:34px;font-weight:700;line-height:1;}\n.ln-avatar:has(img.is-ready) .ln-fallback{display:none;}\n.ln-panel{position:relative;background:#ecebe5;padding:13px 40px 14px 18px;min-width:320px;}\n.ln-edge{position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--ln-accent);}\n.ln-team{display:flex;align-items:center;gap:8px;margin-bottom:3px;}\n.ln-team:not(:has(.ln-team-name:not(:empty),img.is-ready)){display:none;}\n.ln-team-logo{position:relative;width:var(--ln-team-logo);height:var(--ln-team-logo);flex:0 0 auto;display:flex;align-items:center;justify-content:center;}\n.ln-team-logo img{width:100%;height:100%;object-fit:contain;display:none;}\n.ln-team-logo img.is-ready{display:block;}\n.ln-team-fallback{width:6px;height:6px;background:#111;}\n.ln-team-logo:has(img.is-ready) .ln-team-fallback{display:none;}\n.ln-team-name{color:#1a1a18;font-size:var(--ln-team-size);font-weight:700;letter-spacing:1.5px;line-height:1.2;white-space:nowrap;max-width:420px;overflow:hidden;text-overflow:ellipsis;}\n.ln-team-name:empty{display:none;}\n.ln-name{color:#111110;font-size:var(--ln-name-size);font-weight:800;letter-spacing:.3px;line-height:1.12;white-space:nowrap;}\n.ln-sub{color:#55554f;font-size:var(--ln-sub-size);font-weight:400;line-height:1.35;margin-top:2px;white-space:nowrap;min-height:1.35em;}\n.ln-sub:empty{display:none;}"
}
